# Supabase — Settings → API Keys (formato nuevo 2025+)
# Backend: usa la SECRET key (sb_secret_...), NO la publishable ni la contraseña de la BD
SUPABASE_URL=https://nptjrxtiaaadgcpguwrl.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_tu_secret_key_aqui

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# JWT access token (corta duración)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10

# Refresh token (larga duración, opaco + hash en BD)
JWT_REFRESH_EXPIRE_DAYS=7
REFRESH_TOKEN_PEPPER=otro_secreto_largo_distinto_al_jwt_secret

# Secreto que el frontend envía a POST /api/v1/auth/token
API_CLIENT_SECRET=portfolio_front_secret_2026
